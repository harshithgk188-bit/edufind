# ==============================================================================
# EduFind Backend Production Environment Variables
# ==============================================================================

# Application Details
PROJECT_NAME="EduFind - Smart College & Course Discovery System"
PROJECT_VERSION="1.0.0"

# JWT Secret Key - In production, generate a secure random string (e.g., using `openssl rand -hex 32`)
# DO NOT leave this as default in production!
SECRET_KEY=generate_a_random_64_character_hex_secret_here

# JWT Algorithm and Expiration (in minutes)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloud Database Connection String (MySQL 8.0 on Aiven, TiDB, Railway, etc.)
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Example for Aiven MySQL:
# DATABASE_URL=mysql+pymysql://avnadmin:AVNS_example@mysql-edufind-demo.aivencloud.com:12345/defaultdb?ssl_verify_cert=false
# Example for local SQLite fallback:
# DATABASE_URL=sqlite:///./edufind.db
DATABASE_URL=mysql+pymysql://username:password@host.aivencloud.com:port/database_name

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. your Vercel URL and local testing URLs)
# Example: ALLOWED_ORIGINS=https://edufind.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://your-edufind-app.vercel.app,http://localhost:3000

# Optional AI Assistant API Keys (System includes built-in verified database NLP engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
