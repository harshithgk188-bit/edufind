# EduFind Frontend Environment Variables
# In production (Vercel), set VITE_API_URL to your deployed Render backend URL.
# Example: VITE_API_URL=https://edufind-backend.onrender.com
# In local development, you can leave it empty to use Vite's proxy (/api -> localhost:8000)

VITE_API_URL=https://your-backend-service.onrender.com
